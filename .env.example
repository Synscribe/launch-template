# Required before a production launch audit.
NEXT_PUBLIC_SITE_NAME="Launch Template"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Canonical positioning sentence. Keep it under 155 characters and use the same
# sentence in homepage metadata, visible copy, and WebSite structured data.
NEXT_PUBLIC_SITE_DESCRIPTION="Launch Template is a Next.js website foundation for developers and business owners building with Claude Code, Codex, or another AI coding tool."
NEXT_PUBLIC_DEPLOYMENT_ENV="local"

# Optional. Leave absent when the site should not publish them.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""

# Blog is included by default. Replace this demo Wisp publication ID for a
# client project. Set the content origin only for source-relative links/media.
WISP_BLOG_ID="clvlugru90000o4g8ahxp069s"
WISP_CONTENT_ORIGIN=""

# PostHog is included by default. Add the project token to activate it.
# Remove src/instrumentation-client.ts and posthog-js if analytics is not used.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Contact delivery is server-only. Set every value or leave every value blank.
# CONTACT_TO_EMAIL must be the reviewed recipient for the current project.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""
CONTACT_TO_EMAIL=""
