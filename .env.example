# Required before a production launch audit.
NEXT_PUBLIC_SITE_NAME="Launch Template"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DESCRIPTION="A practical Next.js foundation for agentic websites, client migrations, rebuilds, and new launches."
NEXT_PUBLIC_DEPLOYMENT_ENV="local"

# Optional. Leave absent when the site should not publish them.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""

# Blog is included by default. This temporary ID points to Cyber Sierra's
# Wisp publication and should be replaced for a client project.
WISP_BLOG_ID="ee212ba5-28e3-4046-ac0c-ba9ad6e67a54"
WISP_CONTENT_ORIGIN="https://cybersierra.co"

# PostHog is included by default. Add the project token to activate it.
# Remove src/instrumentation-client.ts and posthog-js if analytics is not used.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Contact delivery is server-only. Set every value or leave every value blank.
# CONTACT_TO_EMAIL must be the reviewed recipient for the current project.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""
CONTACT_TO_EMAIL=""
