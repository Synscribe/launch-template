# Set this to the production site's canonical URL before launch.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Internal visual workshop. This server-only allow switch must be set to the
# exact value "true" for /dev, /dev/visuals, and /dev/launch-assets to exist.
# Do not configure it on a public deployment.
VISUAL_REVIEW_ENABLED="true"

# Blog is included by default. Replace this demo Wisp publication ID for a
# client project.
WISP_BLOG_ID="clvlugru90000o4g8ahxp069s"

# PostHog is included by default. Add the project token to activate it.
# Remove src/instrumentation-client.ts and posthog-js if analytics is not used.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Cloudflare Turnstile is optional spam protection for the contact form.
# It stays completely disabled unless both values are present. The site key is
# public; the secret key must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Contact delivery is server-only. Set every value or leave every value blank.
# CONTACT_TO_EMAIL must be the reviewed recipient for the current project.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM=""
CONTACT_TO_EMAIL=""
