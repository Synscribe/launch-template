{
  "name": "next-launch-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm launch:checklist --check && pnpm skills:check && pnpm lint && pnpm typecheck && pnpm test",
    "launch:checklist": "tsx scripts/launch-checklist.ts",
    "launch:verify": "tsx scripts/launch-verify.ts",
    "launch:audit": "tsx scripts/launch-audit.ts",
    "skills:check": "node --test .agents/skills/site-clone/scripts/inventory-sitemap.test.mjs",
    "prepush": "pnpm check && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@wisp-cms/client": "0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.2",
    "lucide-react": "^1.33.0",
    "next": "16.2.9",
    "nodemailer": "^9.0.5",
    "posthog-js": "^1.365.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "2.17.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "20.19.37",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0"
  }
}
